TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
CODEX_HOME=/Users/your-user/.codex

WORLD_HARNESS_ADMIN_USERNAME=hoonzi
WORLD_HARNESS_ADMIN_PASSWORD=change-this-before-running
WORLD_HARNESS_ADMIN_DISPLAY_NAME=Hoonzi
WORLD_HARNESS_GM_PROVIDER=mock

# Optional: use a separately running Hermes Agent gateway/API server as the story GM.
# Set WORLD_HARNESS_GM_PROVIDER=hermes_api to enable these values.
WORLD_HARNESS_HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
WORLD_HARNESS_HERMES_API_KEY=change-me-local-dev
WORLD_HARNESS_HERMES_MODEL=hermes-agent
